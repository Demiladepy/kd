MCP_BEARER_TOKEN=change-me-long-random
PAYSTACK_SECRET_KEY=sk_test_xxx
PUBLIC_BASE_URL=https://kudidesk.onrender.com

# Chain is configuration, not code. Swap these six values for another testnet.
CHAIN_NAME=arc-testnet
CHAIN_ID=5042002
RPC_URL=https://rpc.testnet.arc.network
USDC_ADDRESS=0x3600000000000000000000000000000000000000
EXPLORER_TX_URL=https://testnet.arcscan.app/tx/
GAS_TOKEN_IS_USDC=true

TREASURY_PRIVATE_KEY=0x...        # test wallet ONLY, never reuse a real key
DB_PATH=./kudidesk.db

# Optional: comma-separated Host values for MCP's DNS-rebinding check.
# Leave unset when the server is behind a tunnel or a proxy whose hostname you
# do not know; the endpoint is already gated by MCP_BEARER_TOKEN.
# MCP_ALLOWED_HOSTS=kudidesk.onrender.com,localhost:8000
